.env
.env.*
!.env.example

# Python
__pycache__/
*.pyc
.pytest_cache/
.venv/
backend/data/

# Obsidian vault export (default VAULT_HOST_DIR ./vault; backend/vault when the API runs without Docker).
# Anchored on purpose: a bare `vault/` would also ignore the backend/app/vault/ package.
/vault/
backend/vault/

# Node
node_modules/
frontend/.next/
frontend/out/
*.tsbuildinfo

.DS_Store
eventstudy-run.log
backtest-*.log
.claude/worktrees/

# Study input manifests (hashes of cached personal-use data; never commit)
snapshots/
*-run.log
