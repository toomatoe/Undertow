# Copy to .env (git-ignored). Everything here is optional; the app runs on free sources without it.
# The backend section is read by compose and the backend. The frontend section at the bottom is a template
# for frontend/.env.local: Next.js never reads this root file.
# A blank value (e.g. `ADMIN_TOKEN=`) counts as unset for the backend settings (env_ignore_empty).

# SEC asks for a descriptive User-Agent with a real contact email on every request.
SEC_USER_AGENT="quantdesk-dev your-email@example.com"

# AI summaries / sentiment / event type / ticker tagging.
# Default model is claude-opus-5-5. claude-haiku-5-5 costs ~40x less per token
# and is likely good enough for headline classification. Measure before switching.
ANTHROPIC_API_KEY=
ENRICH_MODEL=claude-opus-5-5
ENRICH_MAX_PER_CYCLE=25

# Alpaca paper-trading keys: free Benzinga news feed now, paper trading later.
# Use PAPER keys only. Never commit live keys.
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=

INGEST_INTERVAL_SECONDS=300

# Real-time alerts: Discord channel > Edit Channel > Integrations > Webhooks > Copy URL
DISCORD_WEBHOOK_URL=
ALERT_MIN_SEVERITY=2
EDGAR_POLL_SECONDS=30

# Public origin of the website (no trailing slash). The backend uses it for links in the weekly newsletter
# (ticker pages, methodology, track record, Edge Lab, disclaimer, archive) and in emails, and it decides the
# default admin policy below (open only while it is a localhost origin). Default http://localhost:3000.
# Next.js does NOT read this root .env: for SEO canonical URLs, sitemap.xml and robots.txt set
# NEXT_PUBLIC_SITE_URL (or PUBLIC_BASE_URL) in frontend/.env.local; see the frontend section below. Keep them equal.
PUBLIC_BASE_URL=http://localhost:3000

# --- Admin protection for mutating endpoints (backend/app/security.py) -----------------------------------
# Covers research launches (POST /api/research/jobs/{kind}), POST /api/ingest, POST /api/alerts/test and
# PUT/DELETE /api/watchlist/{symbol}. Public writes (POST /api/subscribe, POST /api/newsletter/preview) are only rate-limited.
# Order: a token always wins (requests need "Authorization: Bearer <token>", 401 otherwise); without a token the
# flags below decide (403 when off); without a flag, changes are allowed only while PUBLIC_BASE_URL is a localhost origin.
# On a public server set a long random token; enter it in the UI on /status or a Run panel (kept for the browser tab only).
# ADMIN_TOKEN=
# Older, research-only name for the same token; still accepted. ADMIN_TOKEN wins when both are set.
# RESEARCH_ADMIN_TOKEN=
# Without a token: turn research launches (Edge Lab / Backtest Run buttons) on or off. Falls back to MUTATIONS_ENABLED.
# RESEARCH_JOBS_ENABLED=false
# Without a token: turn the other mutations (ingest, alerts/test, watchlist) on or off.
# MUTATIONS_ENABLED=false

# --- Rate limits (per client, sliding 60-second window, in-memory, one API worker) ------------------------
# Every request except /api/stream and /api/health; 0 disables the tier. Over the limit: 429 with Retry-After.
# RATE_LIMIT_PER_MINUTE=120
# POST/PUT/PATCH/DELETE (incl. subscribe and newsletter preview); 0 disables the tier.
# RATE_LIMIT_WRITE_PER_MINUTE=10
# Read the client from X-Forwarded-For (right-most hop outside private/loopback ranges) only when the direct peer
# is a private/loopback address. Turn on only behind a reverse proxy you control.
# TRUST_PROXY_HEADERS=false

# --- Email delivery (backend/app/delivery/): double opt-in list, weekly newsletter, daily digest ----------
# Off unless SMTP_HOST, EMAIL_FROM and EMAIL_POSTAL_ADDRESS are all set (POST /api/subscribe returns 503 until then).
# SMTP_HOST=smtp.yourprovider.com
# 587 = STARTTLS (default); 465 = implicit TLS.
# SMTP_PORT=587
# SMTP_USERNAME=
# Keep the password in .env only.
# SMTP_PASSWORD=
# Ignored on port 465.
# SMTP_STARTTLS=true
# SMTP_TIMEOUT_SECONDS=20
# Sender on a domain with SPF/DKIM/DMARC.
# EMAIL_FROM=QuantDesk <radar@yourdomain.com>
# Reply-To, and the mailto: target in the List-Unsubscribe header.
# EMAIL_REPLY_TO=hello@yourdomain.com
# Required physical postal address (CAN-SPAM), printed in every email footer.
# EMAIL_POSTAL_ADDRESS=Street, City, State ZIP, Country
# ET hour (0-23) from which the digest for the finished previous ET day is sent.
# EMAIL_DAILY_DIGEST_HOUR_ET=7
# Sends per fan-out call; the rest is deferred to the next call.
# EMAIL_MAX_PER_RUN=500
# Public origin where the API's /api/... routes are reachable (confirm/unsubscribe links). Default PUBLIC_BASE_URL,
# which only works when the site proxies /api to the backend; otherwise set the API origin here.
# EMAIL_LINK_BASE_URL=https://api.yourdomain.com
# Key for unsubscribe tokens. Unset: a random key is created once at {DATA_DIR}/delivery/token_key.
# Changing or losing it invalidates every unsubscribe link already sent.
# EMAIL_TOKEN_SECRET=

# --- Not read from this file ------------------------------------------------------------------------------
# POSTGRES_PASSWORD (required) and ADMIN_TOKEN (required) for docker-compose.prod.yml go in an env file outside git,
#   passed with --env-file (see the header of docker-compose.prod.yml).
# GIT_SHA: code version written into study manifests (app.research.snapshot); scripts/reproduce.sh and `make snapshot` set it.
# REPRO_BUILD=1: makes scripts/reproduce.sh rebuild the api image first.

# ---------------------------------------------------------------------------------------------------------
# Frontend (template for frontend/.env.local, git-ignored). Next.js reads only frontend/.env* files and the
# real process environment, never this root .env, so these lines stay commented here. To use them:
#   copy the lines below into frontend/.env.local and remove the leading "# ". Everything is optional.
#
# API origin as seen from the browser (used by src/lib/api.ts). Default http://localhost:8000. Inlined at build time
# (the production image takes it as a build arg: frontend/Dockerfile).
# NEXT_PUBLIC_API_URL=http://localhost:8000
#
# API origin as seen from the Next server (server components, generateMetadata, sitemap.ts via
# src/lib/server-api.ts). Only needed when it differs from the browser's, e.g. inside Docker.
# Falls back to NEXT_PUBLIC_API_URL, then http://localhost:8000. Read at server runtime.
# API_URL_INTERNAL=http://api:8000
#
# Public origin of this site, no trailing slash: canonical URLs, og:url, JSON-LD, sitemap.xml, robots.txt.
# Default http://localhost:3000 (a warning is logged in production when unset). Inlined at build time.
# Must equal the backend's PUBLIC_BASE_URL above, which builds the newsletter links.
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
#
# Fallback for NEXT_PUBLIC_SITE_URL when that is unset (only when set in a frontend env file). Read at server runtime.
# PUBLIC_BASE_URL=http://localhost:3000
