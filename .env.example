# Copy to .env (git-ignored). Everything here is optional; the app runs on free sources without it.
# The backend section is read by compose and the backend. The frontend section at the bottom is a template
# for frontend/.env.local: Next.js never reads this root file.

# SEC asks for a descriptive User-Agent with a real contact email on every request.
SEC_USER_AGENT="quantdesk-dev your-email@example.com"

# AI summaries / sentiment / event type / ticker tagging.
# Default model is claude-opus-5-5. claude-haiku-5-5 costs ~40x less per token
# and is likely good enough for headline classification. Measure before switching.
ANTHROPIC_API_KEY=
ENRICH_MODEL=claude-opus-5-5
ENRICH_MAX_PER_CYCLE=25

# Alpaca paper-trading keys: free Benzinga news feed now, paper trading later.
# Use PAPER keys only. Never commit live keys.
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=

INGEST_INTERVAL_SECONDS=300

# Real-time alerts: Discord channel > Edit Channel > Integrations > Webhooks > Copy URL
DISCORD_WEBHOOK_URL=
ALERT_MIN_SEVERITY=2
EDGAR_POLL_SECONDS=30

# Public origin of the website (no trailing slash). The backend uses it for links in the weekly newsletter
# (ticker pages, methodology, track record, Edge Lab, disclaimer, archive). Default http://localhost:3000.
# Next.js does NOT read this root .env: for SEO canonical URLs, sitemap.xml and robots.txt set
# NEXT_PUBLIC_SITE_URL (or PUBLIC_BASE_URL) in frontend/.env.local; see the frontend section below. Keep them equal.
PUBLIC_BASE_URL=http://localhost:3000

# ---------------------------------------------------------------------------------------------------------
# Frontend (template for frontend/.env.local, git-ignored). Next.js reads only frontend/.env* files and the
# real process environment, never this root .env, so these lines stay commented here. To use them:
#   copy the lines below into frontend/.env.local and remove the leading "# ". Everything is optional.
#
# API origin as seen from the browser (used by src/lib/api.ts). Default http://localhost:8000. Inlined at build time.
# NEXT_PUBLIC_API_URL=http://localhost:8000
#
# API origin as seen from the Next server (server components, generateMetadata, sitemap.ts via
# src/lib/server-api.ts). Only needed when it differs from the browser's, e.g. inside Docker.
# Falls back to NEXT_PUBLIC_API_URL, then http://localhost:8000. Read at server runtime.
# API_URL_INTERNAL=http://api:8000
#
# Public origin of this site, no trailing slash: canonical URLs, og:url, JSON-LD, sitemap.xml, robots.txt.
# Default http://localhost:3000 (a warning is logged in production when unset). Inlined at build time.
# Must equal the backend's PUBLIC_BASE_URL above, which builds the newsletter links.
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
#
# Fallback for NEXT_PUBLIC_SITE_URL when that is unset (only when set in a frontend env file). Read at server runtime.
# PUBLIC_BASE_URL=http://localhost:3000
