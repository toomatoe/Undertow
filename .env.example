# Copy to .env (git-ignored); scripts/start.ps1 does this on first run. Everything here is optional: Undertow runs
# locally on free sources with these defaults and no keys. Site: http://localhost:3000, API: http://localhost:8000.
# The backend section is read by compose and the backend. The frontend section at the bottom is a template
# for frontend/.env.local: Next.js never reads this root file.
# A blank value (e.g. `ADMIN_TOKEN=`) counts as unset for the backend settings (env_ignore_empty).
# Never put real keys in this file; put them only in your own .env.

# SEC asks for a descriptive User-Agent with a contact address on every request. The built-in default works for
# light local use; set your own "name contact" string here in .env if SEC throttles you. Never commit it.
# SEC_USER_AGENT=

INGEST_INTERVAL_SECONDS=300
# Fast EDGAR loop (8-K and other signal forms, Nasdaq halts and the live Form 4 forward test); 0 = join the slow cycle.
EDGAR_POLL_SECONDS=30

# Live insider-cluster forward test (backend/app/insiders/live.py): polls new Form 4 filings with the fast EDGAR loop
# and records micro-cap cluster purchases as a forward-test signal. On by default, needs no key; false = no Form 4 requests.
# INSIDER_LIVE_ENABLED=true

# Site origin: where the frontend runs (no trailing slash), NOT the API origin (http://localhost:8000).
# The backend uses it for links in the weekly newsletter and emails (ticker pages, methodology, track record,
# Edge Lab, disclaimer, archive), and a localhost value keeps the admin policy below open on this machine.
# Keep it equal to NEXT_PUBLIC_SITE_URL (frontend section below). The local default needs no change.
PUBLIC_BASE_URL=http://localhost:3000

# --- Obsidian vault export (backend/app/vault/; README "Using Undertow with Obsidian") --------------------------
# On by default, needs no key. Writes plain Markdown only under <vault>/Undertow/ and never deletes anything.
# VAULT_ENABLED=true
# Host folder bind-mounted to /app/vault in the api container (compose only; default ./vault in the repo, git-ignored).
# Point it at an existing Obsidian vault with an absolute path, then run `docker compose up -d api` to remount.
# VAULT_HOST_DIR=./vault
# Signal filings newer than this many days get Signal notes (and their tickers Ticker notes).
# VAULT_LOOKBACK_DAYS=30
# How often the scheduler runs the export (it also runs at startup and via "Export now" on /status).
# VAULT_EXPORT_MINUTES=15
# (VAULT_DIR is the path inside the container; compose sets it to /app/vault, so leave it unset here.)
# Never let two sync services (e.g. Obsidian Sync plus iCloud/OneDrive/Dropbox) manage the same vault folder.

# --- Optional, off by default: Claude enrichment (AI summaries / sentiment / event type / filing red flags) -------
# Off while ANTHROPIC_API_KEY is blank. Default model claude-opus-5-5; claude-haiku-5-5 costs ~40x less per token
# and is likely good enough for headline classification. Measure before switching.
ANTHROPIC_API_KEY=
ENRICH_MODEL=claude-opus-5-5
ENRICH_MAX_PER_CYCLE=25

# --- Optional, off by default: Alpaca (Benzinga) news -------------------------------------------------------------
# Off unless both keys are set. Free with an Alpaca paper account. PAPER keys only, used for news only (Undertow
# never places orders). Never commit live keys.
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=

# --- Optional, off by default: Discord alerts -----------------------------------------------------------------------
# Off while blank (alerts are still evaluated and logged at /api/alerts).
# Discord channel > Edit Channel > Integrations > Webhooks > Copy URL. Keep the URL in .env only.
DISCORD_WEBHOOK_URL=
ALERT_MIN_SEVERITY=2

# --- Admin protection for mutating endpoints (backend/app/security.py) -----------------------------------
# Covers research launches (POST /api/research/jobs/{kind}), POST /api/ingest, POST /api/alerts/test,
# POST /api/vault/export and PUT/DELETE /api/watchlist/{symbol}. Public writes (POST /api/subscribe, POST /api/newsletter/preview) are only rate-limited.
# Order: a token always wins (requests need "Authorization: Bearer <token>", 401 otherwise); without a token the
# flags below decide (403 when off); without a flag, changes are allowed only while PUBLIC_BASE_URL is a localhost
# origin (the local default, so nothing needs setting here). Compose binds every port to 127.0.0.1.
# To lock writes down anyway, set a long random token and enter it in the UI on /status or a Run panel.
# ADMIN_TOKEN=
# Older, research-only name for the same token; still accepted. ADMIN_TOKEN wins when both are set.
# RESEARCH_ADMIN_TOKEN=
# Without a token: turn research launches (Edge Lab / Backtest Run buttons) on or off. Falls back to MUTATIONS_ENABLED.
# RESEARCH_JOBS_ENABLED=false
# Without a token: turn the other mutations (ingest, alerts/test, watchlist, vault export) on or off.
# MUTATIONS_ENABLED=false

# --- Rate limits (per client, sliding 60-second window, in-memory, one API worker) ------------------------
# Every request except /api/stream and /api/health; 0 disables the tier. Over the limit: 429 with Retry-After.
# RATE_LIMIT_PER_MINUTE=120
# POST/PUT/PATCH/DELETE (incl. subscribe and newsletter preview); 0 disables the tier.
# RATE_LIMIT_WRITE_PER_MINUTE=10
# Read the client from X-Forwarded-For only behind a reverse proxy you control. Not needed for local use.
# TRUST_PROXY_HEADERS=false

# --- Optional, off by default: email delivery (backend/app/delivery/) ---------------------------------------------
# Double opt-in list, weekly newsletter emails, daily digest. Off unless SMTP_HOST, EMAIL_FROM and
# EMAIL_POSTAL_ADDRESS are all set (POST /api/subscribe returns 503 until then; newsletters are still built locally).
# SMTP server host name of your email provider.
# SMTP_HOST=
# 587 = STARTTLS (default); 465 = implicit TLS.
# SMTP_PORT=587
# SMTP_USERNAME=
# Keep the password in .env only.
# SMTP_PASSWORD=
# Ignored on port 465.
# SMTP_STARTTLS=true
# SMTP_TIMEOUT_SECONDS=20
# Sender: a display name plus an address on a domain with SPF/DKIM/DMARC, in the usual "Name <address>" form.
# EMAIL_FROM=
# Reply-To address, and the mailto: target in the List-Unsubscribe header.
# EMAIL_REPLY_TO=
# Required physical postal address (CAN-SPAM), printed in every email footer.
# EMAIL_POSTAL_ADDRESS=
# ET hour (0-23) from which the digest for the finished previous ET day is sent.
# EMAIL_DAILY_DIGEST_HOUR_ET=7
# Sends per fan-out call; the rest is deferred to the next call.
# EMAIL_MAX_PER_RUN=500
# Origin where the API's /api/... routes are reachable (confirm/unsubscribe links). Default PUBLIC_BASE_URL, which only
# works when the site proxies /api to the backend; locally set the API origin, e.g. http://localhost:8000.
# EMAIL_LINK_BASE_URL=
# Key for unsubscribe tokens. Unset: a random key is created once at {DATA_DIR}/delivery/token_key.
# Changing or losing it invalidates every unsubscribe link already sent.
# EMAIL_TOKEN_SECRET=

# --- Not read from this file ------------------------------------------------------------------------------
# POSTGRES_PASSWORD and ADMIN_TOKEN for docker-compose.prod.yml (optional, for later; not used by the local setup)
#   go in an env file outside git, passed with --env-file (see the header of docker-compose.prod.yml).
# GIT_SHA: code version written into study manifests (app.research.snapshot); scripts/reproduce.sh and `make snapshot` set it.
# REPRO_BUILD=1: makes scripts/reproduce.sh rebuild the api image first.
# UNDERTOW_REPO_ROOT: repo root for the working-paper number check (default /repo, mounted by scripts/pytest.sh).

# ---------------------------------------------------------------------------------------------------------
# Frontend (template for frontend/.env.local, git-ignored). Next.js reads only frontend/.env* files and the
# real process environment, never this root .env, so these lines stay commented here. The defaults below are what
# the frontend uses when nothing is set, so for local use you need none of them. To override:
#   copy the lines below into frontend/.env.local and remove the leading "# ".
# (The compose `web` profile bakes the two NEXT_PUBLIC_* defaults in as build args and sets API_URL_INTERNAL itself.)
#
# API origin as seen from the browser (used by src/lib/api.ts). Inlined at build time.
# NEXT_PUBLIC_API_URL=http://localhost:8000
#
# API origin as seen from the Next server (server components, generateMetadata, sitemap.ts via
# src/lib/server-api.ts). Only needed when it differs from the browser's, e.g. inside Docker (http://api:8000).
# Falls back to NEXT_PUBLIC_API_URL, then http://localhost:8000. Read at server runtime.
# API_URL_INTERNAL=
#
# Site origin, no trailing slash: canonical URLs, og:url, JSON-LD, sitemap.xml, robots.txt (which disallows
# everything while this is localhost). Inlined at build time. Must equal the backend's PUBLIC_BASE_URL above.
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
#
# Fallback for NEXT_PUBLIC_SITE_URL when that is unset (only when set in a frontend env file). Read at server runtime.
# PUBLIC_BASE_URL=http://localhost:3000
